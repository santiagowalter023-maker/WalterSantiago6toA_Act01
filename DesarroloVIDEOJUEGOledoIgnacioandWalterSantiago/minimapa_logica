import arcade
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
SCREEN_TITLE = "Juego Estancia - Minimapa Completo"
VELOCIDAD = 5
class JuegoEstancia(arcade.Window):
    def __init__(self):
        super().__init__(SCREEN_WIDTH, SCREEN_HEIGHT, SCREEN_TITLE)
        arcade.set_background_color(arcade.color.DARK_GREEN)
        # Variables de la escena (donde va a ir tu mapa de Tiled)
        self.scene = None
        self.player_sprite = None
        # 🎥 Variables de las Cámaras
        self.camera_principal = None
        self.camera_minimapa = None
        # Controles de teclado
        self.tecla_w = False
        self.tecla_s = False
        self.tecla_a = False
        self.tecla_d = False
    def setup(self):
        """ Inicializa el juego y setea los elementos """
        self.scene = arcade.Scene()
        # 1. Crear al Personaje Principal (Lediago)
        # Usamos un bloque azul temporal hasta que pongas tus sprites
        self.player_sprite = arcade.SpriteSolidColor(32, 32, arcade.color.BLUE)
        self.player_sprite.center_x = 400
        self.player_sprite.center_y = 300
        self.scene.add_sprite("Jugador", self.player_sprite)
        # 2. Crear elementos del patio para tener referencia visual
        muro = arcade.SpriteSolidColor(300, 40, arcade.color.GRAY)
        muro.center_x, muro.center_y = 400, 500
        self.scene.add_sprite("Entorno", muro)
        pozo = arcade.SpriteSolidColor(64, 64, arcade.color.BROWN)
        pozo.center_x, pozo.center_y = 600, 200
        self.scene.add_sprite("Entorno", pozo)
        # 3. CONFIGURAR LAS DOS CÁMARAS
        # La principal ocupa toda la pantalla de forma normal
        self.camera_principal = arcade.Camera(SCREEN_WIDTH, SCREEN_HEIGHT)
        self.camera_minimapa = arcade.Camera(viewport=(20, 20, 150, 150))

    def on_draw(self):
        self.clear()
        self.camera_principal.use()
        cam_x = self.player_sprite.center_x - (SCREEN_WIDTH / 2)
        cam_y = self.player_sprite.center_y - (SCREEN_HEIGHT / 2)
        self.camera_principal.move_to((cam_x, cam_y))

        # Dibujamos toda la escena en grande
        self.scene.draw()
        self.camera_minimapa.use()
        # (Restamos 75 porque es la mitad del tamaño de nuestro minimapa de 150x150)
        mini_cam_x = self.player_sprite.center_x - 75
        mini_cam_y = self.player_sprite.center_y - 75
        self.camera_minimapa.move_to((mini_cam_x, mini_cam_y))
        self.scene.draw()
        # ❌ PASO 3: DIBUJAR LA CRUZ ROJA ARRIBA DEL PERSONAJE
        X = self.player_sprite.center_x
        Y = self.player_sprite.center_y
        LADO = 10  # Tamaño de los bracitos de la cruz
        arcade.draw_line(X - LADO, Y, X + LADO, Y, arcade.color.RED, num_pixels=3)
        # Línea Vertical
        arcade.draw_line(X, Y - LADO, X, Y + LADO, arcade.color.RED, num_pixels=3)

    def on_update(self, delta_time):
        """ Actualiza las posiciones y lógicas del juego """
        self.player_sprite.change_x = 0
        self.player_sprite.change_y = 0
        if self.tecla_w: self.player_sprite.change_y = VELOCIDAD
        elif self.tecla_s: self.player_sprite.change_y = -VELOCIDAD
        
        if self.tecla_a: self.player_sprite.change_x = -VELOCIDAD
        elif self.tecla_d: self.player_sprite.change_x = VELOCIDAD
        self.player_sprite.center_x += self.player_sprite.change_x
        self.player_sprite.center_y += self.player_sprite.change_y

    def on_key_press(self, key, modifiers):
        if key == arcade.key.W: self.tecla_w = True
        elif key == arcade.key.S: self.tecla_s = True
        elif key == arcade.key.A: self.tecla_a = True
        elif key == arcade.key.D: self.tecla_d = True

    def on_key_release(self, key, modifiers):
        if key == arcade.key.W: self.tecla_w = False
        elif key == arcade.key.S: self.tecla_s = False
        elif key == arcade.key.A: self.tecla_a = False
        elif key == arcade.key.D: self.tecla_d = False

def main():
    window = JuegoEstancia()
    window.setup()
    arcade.run()

if __name__ == "__main__":
    main()